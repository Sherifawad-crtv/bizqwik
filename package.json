{
  "name": "bizqwik-business-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint src e2e",
    "preview": "vite preview",
    "size": "node scripts/check-size.mjs",
    "test:e2e": "playwright test",
    "check": "npm run tokens -- --check && npm run build && npm run lint && npm run size && npm run motion && npm run ds",
    "motion": "node scripts/check-motion.mjs",
    "ds": "node scripts/check-ds.mjs",
    "tokens": "node scripts/build-tokens.mjs",
    "backend:verify": "bash scripts/backend-verify.sh",
    "backend:verify:live": "bash scripts/backend-verify.sh --live",
    "backend:verify:ci": "bash scripts/backend-verify.sh --ci"
  },
  "dependencies": {
    "@sentry/react": "^11.8.0",
    "@solar-icons/react": "^2.1.0",
    "@supabase/supabase-js": "^2.115.0",
    "jsqr": "^1.4.0",
    "posthog-js": "^1.438.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "qrcode": "^1.5.4",
    "style-dictionary": "^5.8.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  },
  "engines": {
    "node": ">=20.19"
  }
}
