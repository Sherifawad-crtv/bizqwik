{
  "$description": "Bizqwik design tokens (W3C Design Tokens Format 2025.10). The ONLY place design values are edited. `npm run tokens` turns this into tokens.css and tokens.ts. Two layers: `primitive` = raw values with no meaning (never used by screens); everything else = semantic tokens that say what a value is for and point at primitives. Colour grammar: color-[ui element]-[priority]-[state].",

  "primitive": {
    "color": {
      "$type": "color",
      "neutral": {
        "0": { "$value": "#ffffff" },
        "50": { "$value": "#fbfaf7" },
        "100": { "$value": "#f3f2ee" },
        "150": { "$value": "#ecebe5" },
        "200": { "$value": "#e3e1da" },
        "500": { "$value": "#9a96a6" },
        "600": { "$value": "#6c687a" },
        "900": { "$value": "#1a1726" }
      },
      "brand": {
        "$description": "The gym's brand colour. theme.ts can replace all of these at runtime from one hex.",
        "300": { "$value": "#a193ff" },
        "400": { "$value": "#7b5cff" },
        "500": { "$value": "#5a41ff" },
        "600": { "$value": "#4832d6" },
        "700": { "$value": "#4a2fe0" },
        "800": { "$value": "#2e1f99" },
        "alpha-10": { "$value": "rgba(90, 65, 255, 0.1)" },
        "alpha-12": { "$value": "rgba(90, 65, 255, 0.12)" },
        "alpha-16": { "$value": "rgba(90, 65, 255, 0.16)" }
      },
      "green": { "100": { "$value": "#d8efe0" }, "700": { "$value": "#177a4b" } },
      "amber": { "100": { "$value": "#f6e7c4" }, "700": { "$value": "#946200" } },
      "red": { "100": { "$value": "#f6dedc" }, "700": { "$value": "#b23a3a" } },
      "teal": { "100": { "$value": "#d8edf3" }, "700": { "$value": "#1f6a85" } },
      "ink-alpha": {
        "10": { "$value": "rgba(26, 23, 38, 0.1)" },
        "18": { "$value": "rgba(26, 23, 38, 0.18)" }
      }
    }
  },

  "color": {
    "$type": "color",
    "bg": {
      "canvas": { "default": { "$value": "{primitive.color.neutral.100}", "$description": "page background" } },
      "surface": {
        "primary": { "default": { "$value": "{primitive.color.neutral.50}", "$description": "cards, sheets, floating containers" } },
        "secondary": { "default": { "$value": "{primitive.color.neutral.150}", "$description": "inner fills: segmented tracks, search fields, neutral tags" } }
      },
      "fill": {
        "primary": {
          "default": { "$value": "{primitive.color.brand.500}", "$description": "primary button, active control, chart bars" },
          "active": { "$value": "{primitive.color.brand.600}", "$description": "primary fill while pressed" }
        },
        "accent": {
          "default": { "$value": "{primitive.color.brand.alpha-10}", "$description": "soft brand background" },
          "selected": { "$value": "{primitive.color.brand.alpha-12}", "$description": "selected item behind a control (tab circle, chosen roster row)" },
          "active": { "$value": "{primitive.color.brand.alpha-16}", "$description": "highlighted band (time wheel)" },
          "strong": { "$value": "{primitive.color.brand.300}", "$description": "decorative light brand fill (never on buttons or status)" }
        },
        "success": { "default": { "$value": "{primitive.color.green.100}" } },
        "warning": { "default": { "$value": "{primitive.color.amber.100}" } },
        "danger": { "default": { "$value": "{primitive.color.red.100}" } },
        "info": { "default": { "$value": "{primitive.color.teal.100}" } },
        "status": {
          "$description": "Business names for statuses. They point at the general ones, so changing `success` changes `paid`.",
          "paid": { "default": { "$value": "{color.bg.fill.success.default}" } },
          "logging": { "default": { "$value": "{color.bg.fill.warning.default}" } },
          "settled": { "default": { "$value": "{color.bg.fill.accent.selected}" } },
          "frozen": { "default": { "$value": "{color.bg.fill.info.default}" } },
          "danger": { "default": { "$value": "{color.bg.fill.danger.default}" } }
        }
      },
      "avatar": {
        "$description": "the two ends of the avatar gradient (135deg)",
        "start": { "$value": "{primitive.color.brand.400}" },
        "end": { "$value": "{primitive.color.brand.700}" }
      }
    },
    "text": {
      "primary": { "default": { "$value": "{primitive.color.neutral.900}" } },
      "secondary": { "default": { "$value": "{primitive.color.neutral.600}" } },
      "tertiary": { "default": { "$value": "{primitive.color.neutral.500}" } },
      "on-fill": { "default": { "$value": "{primitive.color.neutral.0}", "$description": "text on a primary fill" } },
      "accent": {
        "default": { "$value": "{primitive.color.brand.600}", "$description": "brand-coloured text" },
        "strong": { "$value": "{primitive.color.brand.800}", "$description": "text on the light decorative brand fill" }
      },
      "success": { "default": { "$value": "{primitive.color.green.700}" } },
      "warning": { "default": { "$value": "{primitive.color.amber.700}" } },
      "danger": { "default": { "$value": "{primitive.color.red.700}" } },
      "info": { "default": { "$value": "{primitive.color.teal.700}" } },
      "status": {
        "paid": { "default": { "$value": "{color.text.success.default}" } },
        "logging": { "default": { "$value": "{color.text.warning.default}" } },
        "settled": { "default": { "$value": "{color.text.accent.default}" } },
        "frozen": { "default": { "$value": "{color.text.info.default}" } },
        "danger": { "default": { "$value": "{color.text.danger.default}" } }
      }
    },
    "icon": {
      "primary": { "default": { "$value": "{color.text.primary.default}" } },
      "secondary": { "default": { "$value": "{color.text.secondary.default}" } },
      "tertiary": { "default": { "$value": "{color.text.tertiary.default}" } },
      "accent": { "default": { "$value": "{color.text.accent.default}" } }
    },
    "border": {
      "primary": { "default": { "$value": "{primitive.color.neutral.200}", "$description": "dividers and field outlines (cards have no stroke)" } }
    }
  },

  "space": {
    "$type": "dimension",
    "1": { "$value": "4px" },
    "2": { "$value": "8px" },
    "3": { "$value": "12px" },
    "4": { "$value": "16px" },
    "5": { "$value": "20px" },
    "6": { "$value": "24px" },
    "8": { "$value": "32px" }
  },

  "radius": {
    "$type": "dimension",
    "$description": "One value per kind; nested shapes follow outer = inner + padding.",
    "card": { "$value": "28px", "$description": "every surface on a page: cards, tiles, charts, hero, list cards" },
    "sheet": { "$value": "40px", "$description": "bottom sheets (20 padding inside)" },
    "item": { "$value": "20px", "$description": "fields, notices, thumbnails inside a sheet (40 - 20)" },
    "chip": { "$value": "8px", "$description": "small tags, icon boxes in cards, calendar blocks (28 - 20)" },
    "button": { "$value": "24px", "$description": "buttons (a 48px button is a full pill)" },
    "float": { "$value": "32px", "$description": "floating action container (button 24 + padding 8)" },
    "full": { "$value": "999px", "$description": "pills, circles, avatars, switches, the tab bar" }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "body": { "$value": ["Urbanist", "system-ui", "sans-serif"] },
      "mono": { "$value": ["Space Mono", "ui-monospace", "monospace"] }
    },
    "size": {
      "$type": "dimension",
      "$description": "Raw size steps. Screens use the text styles below, not these.",
      "11": { "$value": "11px" },
      "12": { "$value": "12px" },
      "13": { "$value": "13px" },
      "14": { "$value": "14px" },
      "15": { "$value": "15px" },
      "16": { "$value": "16px" },
      "20": { "$value": "20px" },
      "24": { "$value": "24px" },
      "26": { "$value": "26px" },
      "30": { "$value": "30px" },
      "56": { "$value": "56px" }
    }
  },

  "text": {
    "$description": "Text styles named after Apple's roles, at Bizqwik's own sizes. Each role has size and weight (and line height / tracking where it differs from the default).",
    "large-title": { "size": { "$type": "dimension", "$value": "{font.size.30}" }, "weight": { "$type": "fontWeight", "$value": 800 } },
    "title-1": { "size": { "$type": "dimension", "$value": "{font.size.26}" }, "weight": { "$type": "fontWeight", "$value": 800 } },
    "title-2": { "size": { "$type": "dimension", "$value": "{font.size.20}" }, "weight": { "$type": "fontWeight", "$value": 700 } },
    "headline": { "size": { "$type": "dimension", "$value": "{font.size.16}" }, "weight": { "$type": "fontWeight", "$value": 700 } },
    "callout": { "size": { "$type": "dimension", "$value": "{font.size.16}" }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "body": { "size": { "$type": "dimension", "$value": "{font.size.15}" }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "subheadline": { "size": { "$type": "dimension", "$value": "{font.size.14}" }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "footnote": { "size": { "$type": "dimension", "$value": "{font.size.13}" }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "caption-1": { "size": { "$type": "dimension", "$value": "{font.size.12}" }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "caption-2": { "size": { "$type": "dimension", "$value": "{font.size.11}" }, "weight": { "$type": "fontWeight", "$value": 500 } },
    "label": { "size": { "$type": "dimension", "$value": "{font.size.11}" }, "weight": { "$type": "fontWeight", "$value": 700 }, "$description": "small uppercase mono labels" },
    "meta": { "size": { "$type": "dimension", "$value": "{font.size.13}" }, "weight": { "$type": "fontWeight", "$value": 400 }, "$description": "secondary mono text" },
    "stat-xl": { "size": { "$type": "dimension", "$value": "{font.size.56}" }, "weight": { "$type": "fontWeight", "$value": 800 } },
    "stat-lg": { "size": { "$type": "dimension", "$value": "{font.size.30}" }, "weight": { "$type": "fontWeight", "$value": 800 } },
    "stat-md": { "size": { "$type": "dimension", "$value": "{font.size.24}" }, "weight": { "$type": "fontWeight", "$value": 800 } },
    "stat-sm": { "size": { "$type": "dimension", "$value": "{font.size.20}" }, "weight": { "$type": "fontWeight", "$value": 800 } }
  },

  "duration": {
    "$type": "duration",
    "$description": "Nothing moves for more than 350ms.",
    "quick": { "$value": "150ms", "$description": "fades, colour changes, presses, tooltips, titles" },
    "standard": { "$value": "250ms", "$description": "things appearing: banners, rows, content" },
    "control": { "$value": "300ms", "$description": "controls that travel: switches, sliding pills, reveals" },
    "screen": { "$value": "340ms", "$description": "pushing into / backing out of a screen, sheets opening" },
    "sheet-out": { "$value": "280ms", "$description": "sheets closing" },
    "max": { "$value": "350ms", "$description": "the ceiling; npm run motion enforces it" },
    "success-hold": { "$value": "700ms", "$description": "not a motion: how long a confirmation stays before closing" }
  },

  "ease": {
    "$type": "cubicBezier",
    "standard": { "$value": [0.32, 0.72, 0, 1], "$description": "the iOS standard curve" },
    "spring": { "$value": [0.34, 1.36, 0.64, 1], "$description": "gentle overshoot for confirmations" }
  },

  "shadow": {
    "$type": "shadow",
    "float": { "$value": { "color": "{primitive.color.ink-alpha.18}", "offsetX": "0px", "offsetY": "14px", "blur": "34px", "spread": "0px" }, "$description": "things floating over the page" },
    "card": { "$value": { "color": "{primitive.color.ink-alpha.10}", "offsetX": "0px", "offsetY": "24px", "blur": "60px", "spread": "0px" } }
  }
}
